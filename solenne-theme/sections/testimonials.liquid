    },
    {
      "type": "text",
      "id": "testimonial_2_name",
      "label": "Testimonial 2 Name",
      "default": "Marcus T."
    },
    {
      "type": "text",
      "id": "testimonial_2_role",
      "label": "Testimonial 2 Role",
      "default": "Professional Athlete & Entrepreneur"
    },
    {
      "type": "textarea",
      "id": "testimonial_3_text",
      "label": "Testimonial 3 Text",
      "default": "The installation team arrived precisely on schedule, treated our home with extraordinary care, and had the unit running within two hours. Six months later, I use it every single day. The Solenne I has become the most important object in my home."
    },
    {
      "type": "text",
      "id": "testimonial_3_name",
