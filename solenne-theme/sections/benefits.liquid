<section class="benefits" id="benefits">
  <div class="benefits__header reveal-up">
    <p class="section-eyebrow">{{ section.settings.eyebrow | default: 'Engineered for Excellence' }}</p>
    <h2 class="section-title">{{ section.settings.title | default: 'Built Without Compromise' }}</h2>
    <p class="section-subtitle">{{ section.settings.subtitle | default: 'Every detail of the Solenne I has been crafted with one intent: to give you the most transformative cold therapy experience in existence.' }}</p>
  </div>

  <div class="benefits__grid">

    <!-- Benefit 1: Precision Temperature Control -->
    <div class="benefit-card reveal-up" style="--delay: 0ms">
      <div class="benefit-card__icon" aria-hidden="true">
        <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="20" cy="20" r="19" stroke="#c9a96e" stroke-width="1"/>
          <path d="M20 8v12M20 28v4" stroke="#c9a96e" stroke-width="1.5" stroke-linecap="round"/>
          <path d="M14 14l8.5 8.5" stroke="#c9a96e" stroke-width="1.5" stroke-linecap="round"/>
          <circle cx="20" cy="24" r="3" stroke="#c9a96e" stroke-width="1.5"/>
          <path d="M20 12v-2" stroke="#c9a96e" stroke-width="1" stroke-linecap="round"/>
          <path d="M14 14l-1.4-1.4M26 14l1.4-1.4" stroke="#c9a96e" stroke-width="1" stroke-linecap="round"/>
          <path d="M12 20H10M30 20h-2" stroke="#c9a96e" stroke-width="1" stroke-linecap="round"/>
        </svg>
      </div>
      <h3 class="benefit-card__title">{{ section.settings.benefit_1_title | default: 'Precision Temperature Control' }}</h3>
      <p class="benefit-card__description">{{ section.settings.benefit_1_desc | default: 'Dual-compressor chilling system maintains temperature within ±0.5°F. Set your target, the Solenne I does the rest — silently and without interruption.' }}</p>
    </div>

    <!-- Benefit 2: Medical-Grade Filtration -->
    <div class="benefit-card reveal-up" style="--delay: 100ms">
      <div class="benefit-card__icon" aria-hidden="true">
        <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="20" cy="20" r="19" stroke="#c9a96e" stroke-width="1"/>
          <path d="M12 13h16l-2 6H14l-2-6z" stroke="#c9a96e" stroke-width="1.5" stroke-linejoin="round"/>
          <path d="M14 19l1 8h10l1-8" stroke="#c9a96e" stroke-width="1.5" stroke-linejoin="round"/>
          <path d="M17 22v4M20 22v4M23 22v4" stroke="#c9a96e" stroke-width="1" stroke-linecap="round"/>
          <circle cx="20" cy="11" r="1.5" stroke="#c9a96e" stroke-width="1"/>
          <path d="M20 12.5v0.5" stroke="#c9a96e" stroke-width="1" stroke-linecap="round"/>
        </svg>
      </div>
      <h3 class="benefit-card__title">{{ section.settings.benefit_2_title | default: 'Medical-Grade Filtration' }}</h3>
      <p class="benefit-card__description">{{ section.settings.benefit_2_desc | default: 'A five-stage UV and ozone purification system eliminates 99.9% of bacteria and pathogens — delivering spa-clean water that is as pure as your recovery ritual.' }}</p>
    </div>

    <!-- Benefit 3: Lifetime Craftsmanship -->
    <div class="benefit-card reveal-up" style="--delay: 200ms">
      <div class="benefit-card__icon" aria-hidden="true">
        <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="20" cy="20" r="19" stroke="#c9a96e" stroke-width="1"/>
          <path d="M20 10l2.5 5 5.5.8-4 3.9.9 5.5-4.9-2.6L15.1 25l.9-5.5-4-3.9 5.5-.8L20 10z" stroke="#c9a96e" stroke-width="1.5" stroke-linejoin="round"/>
          <path d="M14 29l3-3M26 29l-3-3" stroke="#c9a96e" stroke-width="1.5" stroke-linecap="round"/>
          <path d="M17 31h6" stroke="#c9a96e" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </div>
      <h3 class="benefit-card__title">{{ section.settings.benefit_3_title | default: 'Lifetime Craftsmanship' }}</h3>
      <p class="benefit-card__description">{{ section.settings.benefit_3_desc | default: 'Handcrafted by master fabricators using 316L marine-grade stainless steel. Every weld, every finish, every edge is held to an exacting standard that outlasts a lifetime.' }}</p>
    </div>

    <!-- Benefit 4: Concierge Installation -->
    <div class="benefit-card reveal-up" style="--delay: 300ms">
      <div class="benefit-card__icon" aria-hidden="true">
        <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="20" cy="20" r="19" stroke="#c9a96e" stroke-width="1"/>
          <rect x="13" y="16" width="14" height="12" rx="2" stroke="#c9a96e" stroke-width="1.5"/>
          <path d="M16 16v-3a4 4 0 0 1 8 0v3" stroke="#c9a96e" stroke-width="1.5" stroke-linecap="round"/>
          <circle cx="20" cy="22" r="2" stroke="#c9a96e" stroke-width="1.5"/>
          <path d="M20 24v2" stroke="#c9a96e" stroke-width="1" stroke-linecap="round"/>
          <path d="M13 30h14" stroke="#c9a96e" stroke-width="1" stroke-linecap="round"/>
        </svg>
      </div>
      <h3 class="benefit-card__title">{{ section.settings.benefit_4_title | default: 'Concierge Installation' }}</h3>
      <p class="benefit-card__description">{{ section.settings.benefit_4_desc | default: 'A dedicated Solenne specialist arrives at your home, handles all plumbing and electrical, and ensures your unit is operating perfectly before departing. Your time is precious.' }}</p>
    </div>

  </div>
</section>

