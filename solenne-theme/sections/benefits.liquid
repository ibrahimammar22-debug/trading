<section class="benefits reveal-section" id="Benefits">
  <div class="benefits__inner container">

    <div class="benefits__header">
      {% if section.settings.eyebrow != blank %}
        <p class="section-eyebrow reveal-up">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="benefits__heading reveal-up" data-delay="100">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="benefits__subheading reveal-up" data-delay="200">{{ section.settings.subheading }}</p>
      {% endif %}
    </div>

    <div class="benefits__grid">

      {% for block in section.blocks %}
        {% if block.type == 'benefit' %}
          <div class="benefit-card reveal-up" data-delay="{{ forloop.index | times: 100 }}" {{ block.shopify_attributes }}>
            <div class="benefit-card__icon" aria-hidden="true">
              {% case block.settings.icon %}
                {% when 'temperature' %}
                  <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 14.76V3.5a2.5 2.5 0 00-5 0v11.26a4.5 4.5 0 105 0z"/>
                    <line x1="12" y1="9" x2="16" y2="9"/>
                    <line x1="12" y1="6" x2="16" y2="6"/>
                  </svg>
                {% when 'filtration' %}
                  <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/>
                    <circle cx="19" cy="19" r="3"/>
                    <line x1="17.5" y1="19" x2="20.5" y2="19"/>
                    <line x1="19" y1="17.5" x2="19" y2="20.5"/>
                  </svg>
                {% when 'craftsmanship' %}
                  <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    <polyline points="9 12 11 14 15 10"/>
                  </svg>
                {% when 'concierge' %}
                  <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
                    <polyline points="9 22 9 12 15 12 15 22"/>
                    <circle cx="12" cy="6" r="1" fill="currentColor"/>
                  </svg>
                {% else %}
                  <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="12 6 12 12 16 14"/>
                  </svg>
              {% endcase %}
            </div>

            <div class="benefit-card__content">
              <h3 class="benefit-card__title">{{ block.settings.title }}</h3>
              <p class="benefit-card__description">{{ block.settings.description }}</p>
            </div>
          </div>
        {% endif %}
      {% else %}

        <!-- Default benefit cards if no blocks configured -->
        <div class="benefit-card reveal-up" data-delay="100">
          <div class="benefit-card__icon" aria-hidden="true">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 14.76V3.5a2.5 2.5 0 00-5 0v11.26a4.5 4.5 0 105 0z"/>
            </svg>
          </div>
          <div class="benefit-card__content">
            <h3 class="benefit-card__title">Precision Temperature Control</h3>
            <p class="benefit-card__description">Maintain your ideal plunge temperature within ±0.5°F. Our proprietary chilling system responds in real time, ensuring a consistent therapeutic experience every session.</p>
          </div>
        </div>

        <div class="benefit-card reveal-up" data-delay="200">
          <div class="benefit-card__icon" aria-hidden="true">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/>
            </svg>
          </div>
          <div class="benefit-card__content">
            <h3 class="benefit-card__title">Medical-Grade Filtration</h3>
            <p class="benefit-card__description">A triple-stage UV filtration system eliminates 99.9% of pathogens, keeping your water pristine and reducing maintenance to near zero between sessions.</p>
          </div>
        </div>

        <div class="benefit-card reveal-up" data-delay="300">
          <div class="benefit-card__icon" aria-hidden="true">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <polyline points="9 12 11 14 15 10"/>
            </svg>
          </div>
          <div class="benefit-card__content">
            <h3 class="benefit-card__title">Lifetime Craftsmanship</h3>
            <p class="benefit-card__description">Every Solenne is hand-finished by master craftsmen in our Portland atelier. We back each unit with a lifetime structural warranty and unlimited service calls.</p>
          </div>
        </div>

        <div class="benefit-card reveal-up" data-delay="400">
          <div class="benefit-card__icon" aria-hidden="true">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
              <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
          </div>
          <div class="benefit-card__content">
            <h3 class="benefit-card__title">Concierge Installation</h3>
            <p class="benefit-card__description">A dedicated Solenne specialist manages your installation from site survey to first plunge. White-glove delivery, in-home setup, and a private onboarding session included.</p>
          </div>
        </div>

      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Benefits",
  "tag": "section",
  "class": "section-benefits",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Why Solenne"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Built Without Compromise"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Section subheading",
      "default": "Every element of the Solenne I is engineered to a standard the wellness industry has never seen."
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "temperature", "label": "Temperature" },
            { "value": "filtration", "label": "Filtration" },
            { "value": "craftsmanship", "label": "Craftsmanship" },
            { "value": "concierge", "label": "Concierge" },
            { "value": "default", "label": "Default" }
          ],
          "default": "default"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Benefit title",
          "default": "Feature Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Benefit description",
          "default": "A concise description of this benefit in two meaningful sentences."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits"
    }
  ]
}
{% endschema %}
