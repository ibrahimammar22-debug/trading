{%- liquid
  assign product = all_products[section.settings.product]
  if product == blank
    assign use_placeholder = true
  endif
-%}

<section class="product-showcase" id="product-showcase">
  <div class="product-showcase__inner">

    <div class="product-showcase__media reveal-left">
      {%- if use_placeholder -%}
        <div class="product-showcase__image-placeholder">
          <svg viewBox="0 0 800 600" xmlns="http://www.w3.org/2000/svg" aria-label="The Solenne I Cold Plunge">
            <rect width="800" height="600" fill="#111111"/>
            <rect x="200" y="100" width="400" height="320" rx="24" fill="#1a1a1a" stroke="#c9a96e" stroke-width="1.5"/>
            <rect x="230" y="130" width="340" height="260" rx="18" fill="#0d0d0d"/>
            <ellipse cx="400" cy="260" rx="130" ry="90" fill="#141414" stroke="#c9a96e" stroke-width="1"/>
            <rect x="160" y="410" width="480" height="30" rx="8" fill="#1a1a1a"/>
            <rect x="220" y="430" width="360" height="60" rx="6" fill="#141414"/>
            <text x="400" y="530" text-anchor="middle" fill="#c9a96e" font-size="14" font-family="Georgia, serif" letter-spacing="3">THE SOLENNE I</text>
          </svg>
        </div>
      {%- else -%}
        {%- if product.featured_image -%}
          <img
            class="product-showcase__image"
            src="{{ product.featured_image | image_url: width: 1000 }}"
            srcset="{{ product.featured_image | image_url: width: 600 }} 600w,
                    {{ product.featured_image | image_url: width: 900 }} 900w,
                    {{ product.featured_image | image_url: width: 1200 }} 1200w"
            sizes="(max-width: 768px) 100vw, 50vw"
            alt="{{ product.featured_image.alt | default: product.title }}"
            loading="lazy"
            width="1000"
            height="750"
          >
        {%- endif -%}
      {%- endif -%}
      <div class="product-showcase__badge">
        <span>{{ section.settings.badge_text | default: 'New' }}</span>
      </div>
    </div>

    <div class="product-showcase__details reveal-right">
      <p class="product-showcase__collection-label">{{ section.settings.collection_label | default: 'Flagship Collection' }}</p>

      <h2 class="product-showcase__title">
        {%- if use_placeholder -%}
          {{ section.settings.placeholder_title | default: 'The Solenne I' }}
        {%- else -%}
          {{ product.title }}
        {%- endif -%}
      </h2>

      <p class="product-showcase__price">
        {%- if use_placeholder -%}
          {{ section.settings.placeholder_price | default: '$15,000' }}
        {%- else -%}
          {{ product.price | money }}
        {%- endif -%}
      </p>

      <div class="product-showcase__divider"></div>

      <p class="product-showcase__description">
        {%- if use_placeholder -%}
          {{ section.settings.placeholder_description | default: 'Precision-engineered from marine-grade stainless steel, the Solenne I delivers therapeutic cold immersion at exact temperatures — from 37°F to 60°F. Designed for the discerning individual who demands nothing less than perfection.' }}
        {%- else -%}
          {{ product.description | strip_html | truncatewords: 60 }}
        {%- endif -%}
      </p>

      <ul class="product-showcase__specs">
        <li class="product-showcase__spec">
          <span class="spec-label">Material</span>
          <span class="spec-value">{{ section.settings.spec_material | default: 'Marine-grade 316L stainless steel' }}</span>
        </li>
        <li class="product-showcase__spec">
          <span class="spec-label">Temperature Range</span>
          <span class="spec-value">{{ section.settings.spec_temp | default: '37°F – 60°F (2.8°C – 15.5°C)' }}</span>
        </li>
        <li class="product-showcase__spec">
          <span class="spec-label">Filtration</span>
          <span class="spec-value">{{ section.settings.spec_filtration | default: 'Medical-grade UV + ozone' }}</span>
        </li>
        <li class="product-showcase__spec">
          <span class="spec-label">Dimensions</span>
          <span class="spec-value">{{ section.settings.spec_dimensions | default: '7.5ft L × 3ft W × 3ft D' }}</span>
        </li>
      </ul>

      <div class="product-showcase__actions">
        {%- if use_placeholder -%}
          <a href="{{ routes.collections_url }}" class="btn btn--primary btn--large">Add to Cart</a>
        {%- else -%}
          <form action="{{ routes.cart_add_url }}" method="post" class="product-form">
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <button type="submit" class="btn btn--primary btn--large" {%- unless product.available %} disabled{%- endunless -%}>
              {%- if product.available -%}
                Add to Cart
              {%- else -%}
                Sold Out
              {%- endif -%}
            </button>
          </form>
        {%- endif -%}
        <a href="{%- if use_placeholder -%}{{ routes.collections_url }}{%- else -%}{{ product.url }}{%- endif -%}" class="btn btn--text">
          View Full Details
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <p class="product-showcase__note">{{ section.settings.financing_note | default: 'White-glove delivery &amp; concierge installation included. Financing available.' }}</p>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Product Showcase",
  "tag": "section",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Featured Product"
    },
    {
      "type": "text",
      "id": "collection_label",
      "label": "Collection Label",
      "default": "Flagship Collection"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "New"
    },
    {
      "type": "text",
      "id": "placeholder_title",
      "label": "Fallback Product Title",
      "default": "The Solenne I"
    },
    {
      "type": "text",
      "id": "placeholder_price",
      "label": "Fallback Price",
      "default": "$15,000"
    },
    {
      "type": "textarea",
      "id": "placeholder_description",
      "label": "Fallback Description",
      "default": "Precision-engineered from marine-grade stainless steel, the Solenne I delivers therapeutic cold immersion at exact temperatures — from 37°F to 60°F. Designed for the discerning individual who demands nothing less than perfection."
    },
    {
      "type": "text",
      "id": "spec_material",
      "label": "Spec: Material",
      "default": "Marine-grade 316L stainless steel"
    },
    {
      "type": "text",
      "id": "spec_temp",
      "label": "Spec: Temperature Range",
      "default": "37°F – 60°F (2.8°C – 15.5°C)"
    },
    {
      "type": "text",
      "id": "spec_filtration",
      "label": "Spec: Filtration",
      "default": "Medical-grade UV + ozone"
    },
    {
      "type": "text",
      "id": "spec_dimensions",
      "label": "Spec: Dimensions",
      "default": "7.5ft L × 3ft W × 3ft D"
    },
    {
      "type": "text",
      "id": "financing_note",
      "label": "Financing Note",
      "default": "White-glove delivery & concierge installation included. Financing available."
    }
  ],
  "presets": [
    {
      "name": "Product Showcase"
    }
  ]
}
{% endschema %}
