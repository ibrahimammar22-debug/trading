    "homepage_faq": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div class=\"solenne-faq\"><div class=\"solenne-faq__inner\"><p class=\"solenne-faq__label\">Common Questions</p><h2 class=\"solenne-faq__title\">Everything you need to know.</h2><div class=\"solenne-faq__item\"><button class=\"solenne-faq__question\" onclick=\"this.closest('.solenne-faq__item').classList.toggle('is-open')\">What makes Solenne different from other cold plunges? <span></span></button><div class=\"solenne-faq__answer\">Solenne systems use a hospital-grade compressor chiller — not just ice or a basic heat exchanger. This means consistent temperatures at the exact degree you set, without constant re-icing or monitoring. Combined with brushed stainless interiors, quiet operation, and a designed aesthetic, it's a fundamentally different product.</div></div><div class=\"solenne-faq__item\"><button class=\"solenne-faq__question\" onclick=\"this.closest('.solenne-faq__item').classList.toggle('is-open')\">How long does delivery take? <span></span></button><div class=\"solenne-faq__answer\">Delivery to the contiguous U.S. typically takes 2–4 weeks from order confirmation. Your system ships via freight carrier in a protective crate with white-glove delivery included — meaning delivery to the room of your choice, unboxing, and basic setup.</div></div><div class=\"solenne-faq__item\"><button class=\"solenne-faq__question\" onclick=\"this.closest('.solenne-faq__item').classList.toggle('is-open')\">What warranty does the Solenne system come with? <span></span></button><div class=\"solenne-faq__answer\">All Solenne systems include a 5-year comprehensive warranty on the chiller unit and a 2-year warranty on structural components. Our specialist support team is available Monday–Saturday to assist with any questions after delivery.</div></div><div class=\"solenne-faq__item\"><button class=\"solenne-faq__question\" onclick=\"this.closest('.solenne-faq__item').classList.toggle('is-open')\">Is financing available? <span></span></button><div class=\"solenne-faq__answer\">Yes. We offer financing options through our partner starting at 0% APR for qualified buyers. Contact our specialist team to discuss payment plans that fit your situation.</div></div></div></div>",
        "color_scheme": "",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },

