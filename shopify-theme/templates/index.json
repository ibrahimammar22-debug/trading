    "philosophy": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div class=\"solenne-philosophy\"><p class=\"solenne-philosophy__label\">The Solenne Difference</p><h2 class=\"solenne-philosophy__headline\">Engineered for those who demand more from their recovery.</h2><div class=\"solenne-philosophy__pillars\"><div class=\"solenne-philosophy__pillar\"><p class=\"solenne-philosophy__pillar-name\">Recovery</p><p class=\"solenne-philosophy__pillar-desc\">Reduce inflammation, flush metabolic waste, and wake muscles faster than any ice bucket can.</p></div><div class=\"solenne-philosophy__pillar\"><p class=\"solenne-philosophy__pillar-name\">Resilience</p><p class=\"solenne-philosophy__pillar-desc\">Cold exposure trains the nervous system. Sharper focus, deeper sleep, and a body that adapts.</p></div><div class=\"solenne-philosophy__pillar\"><p class=\"solenne-philosophy__pillar-name\">Ritual</p><p class=\"solenne-philosophy__pillar-desc\">Not a chore. A practice. Designed to make precision recovery a beautiful part of your daily life.</p></div></div></div>",
        "color_scheme": "",
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },

